# Database (SQLite by default; point to PostgreSQL for production)
# e.g. DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/internaltool
DATABASE_URL=sqlite:///./internaltool.db

# JWT auth
JWT_SECRET_KEY=super-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# External API integration (JSONPlaceholder demo API, no key required)
EXTERNAL_API_BASE_URL=https://jsonplaceholder.typicode.com
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_CACHE_TTL_SECONDS=300

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173
